---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline";
import SkillTree from "../components/SkillTree";
import ScrollReveal from "../components/ScrollReveal";
---

<Layout title="关于我">
  <!-- 页头 -->
  <section class="pt-32 pb-12 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <ScrollReveal client:load>
        <p class="text-xs tracking-widest uppercase text-ink-muted mb-4">About</p>
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-ink mb-5">
          你好，很高兴认识你
        </h1>
        <p class="text-ink-light leading-relaxed max-w-lg mx-auto">
          一名热爱技术的前端工程师，专注于构建高性能、好用的 Web 应用。
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- 个人卡片 -->
  <section class="pb-16 px-6">
    <div class="max-w-2xl mx-auto">
      <ScrollReveal client:load>
        <div class="card p-10">
          <div class="flex flex-col md:flex-row items-center gap-8">
            <div class="w-28 h-28 rounded-full bg-cream-warm flex items-center justify-center text-5xl shrink-0 border-2 border-border">
              👨‍💻
            </div>
            <div>
              <h2 class="text-2xl font-serif font-bold text-ink mb-3">张同学</h2>
              <p class="text-ink-light leading-relaxed text-sm">
                擅长 React 生态、Three.js 3D 图形编程和前端工程化。
                工作之余喜欢摄影、游戏和探索开源世界。相信好的设计能让技术更有温度。
              </p>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- 时间线 -->
  <section class="pb-16 px-6">
    <div class="max-w-3xl mx-auto">
      <ScrollReveal client:load>
        <p class="text-xs tracking-widest uppercase text-ink-muted text-center mb-2">Timeline</p>
        <h2 class="text-3xl font-serif font-bold text-ink mb-14 text-center">我的经历</h2>
      </ScrollReveal>
      <Timeline client:load />
    </div>
  </section>

  <!-- 技能 -->
  <section class="pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <ScrollReveal client:load>
        <p class="text-xs tracking-widest uppercase text-ink-muted text-center mb-2">Skills</p>
        <h2 class="text-3xl font-serif font-bold text-ink mb-14 text-center">技能雷达</h2>
      </ScrollReveal>
      <SkillTree client:load />
    </div>
  </section>
</Layout>
