---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline";
import SkillTree from "../components/SkillTree";
import ScrollReveal from "../components/ScrollReveal";
---

<Layout title="关于我">
  <!-- Page header -->
  <section class="pt-32 pb-16 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <ScrollReveal client:load>
        <h1 class="text-4xl md:text-6xl font-bold gradient-text mb-4">关于我</h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto">
          一个热爱前端、沉迷 3D 图形和开源技术的开发者
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- Bio card -->
  <section class="pb-16 px-6">
    <div class="max-w-3xl mx-auto">
      <ScrollReveal client:load>
        <div class="glass p-8 md:p-12 rounded-2xl">
          <div class="flex flex-col md:flex-row items-center gap-8">
            <!-- Avatar placeholder -->
            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-5xl shrink-0">
              👨‍💻
            </div>
            <div>
              <h2 class="text-2xl font-bold text-white mb-3">你好，我是张同学 👋</h2>
              <p class="text-gray-400 leading-relaxed">
                一名热爱技术的前端工程师，专注于构建高性能、好用的 Web 应用。
                擅长 React 生态、Three.js 3D 图形编程和前端工程化。
                工作之余，我喜欢摄影、游戏和探索开源世界。
              </p>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Timeline -->
  <section class="pb-16 px-6">
    <div class="max-w-4xl mx-auto">
      <ScrollReveal client:load>
        <h2 class="text-3xl font-bold text-white mb-12 text-center">我的经历</h2>
      </ScrollReveal>
      <Timeline client:load />
    </div>
  </section>

  <!-- Skills -->
  <section class="pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <ScrollReveal client:load>
        <h2 class="text-3xl font-bold text-white mb-12 text-center">技能雷达</h2>
      </ScrollReveal>
      <SkillTree client:load />
    </div>
  </section>
</Layout>
