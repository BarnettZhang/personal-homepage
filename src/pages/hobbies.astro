---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import HobbyGrid from "../components/HobbyGrid";
import ScrollReveal from "../components/ScrollReveal";

const hobbies = await getCollection("hobbies");
const sortedHobbies = hobbies
  .sort((a, b) => a.data.order - b.data.order)
  .map((h) => ({
    title: h.data.title,
    description: h.data.description,
    tags: h.data.tags,
    icon: h.data.icon,
  }));
---

<Layout title="兴趣爱好">
  <!-- Header -->
  <section class="pt-32 pb-16 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <ScrollReveal client:load>
        <h1 class="text-4xl md:text-6xl font-bold gradient-text mb-4">兴趣爱好</h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto">
          代码之外，这些是我热爱的事物
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- Hobby grid -->
  <section class="pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <HobbyGrid client:load hobbies={sortedHobbies} />
    </div>
  </section>
</Layout>
