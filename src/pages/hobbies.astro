---
import Layout from "../layouts/Layout.astro";
import GameGallery from "../components/GameGallery";
import AnimeGallery from "../components/AnimeGallery";
import SectionNav from "../components/SectionNav";
import ScrollReveal from "../components/ScrollReveal";
import { games, anime } from "../data/profile";
import { t } from "../i18n/ui";
import steamGames from "../data/steam-games.json";

const lang = Astro.locals.lang;
---

<Layout title={t(lang, "hobbies.title")}>
  <section class="pt-32 pb-10 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <ScrollReveal client:load>
        <p class="text-xs tracking-widest uppercase text-ink-muted mb-4">Life</p>
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-ink mb-5">
          {t(lang, "hobbies.title")}
        </h1>
        <p class="text-ink-light leading-relaxed max-w-lg mx-auto">
          {t(lang, "hobbies.subtitle")}
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- 悬浮目录 -->
  <SectionNav client:load lang={lang} />

  <!-- 游戏 -->
  <section id="games" class="pb-24 px-6 scroll-mt-24">
    <div class="max-w-5xl mx-auto">
      <ScrollReveal client:load>
        <p class="text-xs tracking-widest uppercase text-ink-muted text-center mb-2">Games</p>
        <h2 class="text-3xl font-serif font-bold text-ink mb-14 text-center">{t(lang, "hobbies.gamesTitle")}</h2>
      </ScrollReveal>
      <GameGallery client:load games={games} steamData={steamGames} lang={lang} />
    </div>
  </section>

  <!-- 动漫 -->
  <section id="anime" class="pb-24 px-6 scroll-mt-24">
    <div class="max-w-5xl mx-auto">
      <ScrollReveal client:load>
        <p class="text-xs tracking-widest uppercase text-ink-muted text-center mb-2">Anime</p>
        <h2 class="text-3xl font-serif font-bold text-ink mb-14 text-center">{t(lang, "hobbies.animeTitle")}</h2>
      </ScrollReveal>
      <AnimeGallery client:load anime={anime} lang={lang} />
    </div>
  </section>
</Layout>