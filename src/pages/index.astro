---
import Layout from "../layouts/Layout.astro";
import NexusVortex from "../components/three/NexusVortex";
import HeroSection from "../components/HeroSection";
---

<Layout title="首页">
  <!-- 首屏：3D 文艺场景背景 -->
  <section class="relative h-screen overflow-hidden bg-cream">
    <NexusVortex client:load />
    <HeroSection
      client:load
      name="张同学"
      tagline="写代码、按快门、去远方。"
      description="前端工程师，关注交互设计与视觉表达。在这里记录我的作品和生活。"
    />
  </section>

  <!-- 导航卡片 -->
  <section class="max-w-5xl mx-auto px-6 -mt-16 relative z-10 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a href="/projects" class="card p-8 group cursor-pointer no-underline">
        <div class="w-10 h-10 rounded-xl bg-sage-subtle flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-5 h-5 text-sage" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
          </svg>
        </div>
        <h3 class="text-lg font-serif font-semibold text-ink mb-2">项目作品</h3>
        <p class="text-sm text-ink-muted leading-relaxed">我构建的开源项目和应用。</p>
      </a>

      <a href="/about" class="card p-8 group cursor-pointer no-underline">
        <div class="w-10 h-10 rounded-xl bg-rose-subtle flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-5 h-5 text-rose" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
        <h3 class="text-lg font-serif font-semibold text-ink mb-2">关于我</h3>
        <p class="text-sm text-ink-muted leading-relaxed">我的经历、技能和故事。</p>
      </a>

      <a href="/hobbies" class="card p-8 group cursor-pointer no-underline">
        <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-5 h-5 text-amber" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
        </div>
        <h3 class="text-lg font-serif font-semibold text-ink mb-2">兴趣爱好</h3>
        <p class="text-sm text-ink-muted leading-relaxed">代码之外的热爱。</p>
      </a>
    </div>

    <div class="section-divider" />
  </section>
</Layout>
