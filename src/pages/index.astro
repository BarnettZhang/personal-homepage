---
import Layout from "../layouts/Layout.astro";
import NexusVortex from "../components/three/NexusVortex";
import HeroSection from "../components/HeroSection";
---

<Layout title="首页">
  <!-- Full-screen hero with 3D background -->
  <section class="relative h-screen overflow-hidden bg-gray-950">
    <!-- Three.js 3D background -->
    <NexusVortex client:load />

    <!-- Text overlay -->
    <HeroSection
      client:load
      name="张同学"
      tagline="探索技术边界，创造美好体验。"
      description="我是一名前端开发工程师，热爱 Three.js、交互设计和开源社区。"
    />
  </section>

  <!-- Content below the hero (placeholder for Step 4) -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="glass glass-hover p-8 rounded-2xl">
        <h3 class="text-xl font-semibold text-cyan-400 mb-3">项目作品</h3>
        <p class="text-gray-400">探索我构建的开源项目和应用。</p>
      </div>
      <div class="glass glass-hover p-8 rounded-2xl">
        <h3 class="text-xl font-semibold text-blue-400 mb-3">关于我</h3>
        <p class="text-gray-400">了解我的经历、技能和故事。</p>
      </div>
      <div class="glass glass-hover p-8 rounded-2xl">
        <h3 class="text-xl font-semibold text-purple-400 mb-3">兴趣爱好</h3>
        <p class="text-gray-400">代码之外，我还有这些热爱。</p>
      </div>
    </div>
  </section>
</Layout>
