---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ScrollReveal from "../components/ScrollReveal";

const projects = await getCollection("projects");
const sortedProjects = projects
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title="项目作品">
  <!-- Header -->
  <section class="pt-32 pb-16 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <ScrollReveal client:load>
        <h1 class="text-4xl md:text-6xl font-bold gradient-text mb-4">项目作品</h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto">
          我构建和参与的一些项目
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- Project cards -->
  <section class="pb-24 px-6">
    <div class="max-w-4xl mx-auto space-y-8">
      {sortedProjects.map((project) => (
        <ScrollReveal client:load>
          <article class="glass glass-hover p-8 rounded-2xl">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
              <h2 class="text-2xl font-semibold text-white">{project.data.title}</h2>
              {project.data.featured && (
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                  精选
                </span>
              )}
            </div>

            <p class="text-gray-400 mb-4">{project.data.description}</p>

            {/* Tech tags */}
            <div class="flex flex-wrap gap-2 mb-6">
              {project.data.tech.map((t) => (
                <span class="px-2.5 py-1 text-xs rounded-full bg-white/5 text-gray-400 border border-white/5">
                  {t}
                </span>
              ))}
            </div>

            {/* Links */}
            <div class="flex gap-4">
              {project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-gray-400 hover:text-cyan-400 transition-colors inline-flex items-center gap-1.5"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                  </svg>
                  GitHub
                </a>
              )}
              {project.data.link && (
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-gray-400 hover:text-cyan-400 transition-colors inline-flex items-center gap-1.5"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  在线预览
                </a>
              )}
            </div>
          </article>
        </ScrollReveal>
      ))}
    </div>
  </section>
</Layout>
