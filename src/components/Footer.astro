---
import { profile, socialLinks } from "../data/profile";
---

<footer class="border-t border-border bg-cream-warm/50">
  <div class="max-w-6xl mx-auto px-6 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-sm text-ink-muted">
        &copy; {new Date().getFullYear()} {profile.name} · 用热爱构建
      </p>

      <div class="flex items-center gap-6">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-ink-muted hover:text-sage transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="section-divider" />
    <p class="text-center text-xs text-ink-muted/60">
      由 Astro · React · Three.js 精心打造
    </p>
  </div>
</footer>
