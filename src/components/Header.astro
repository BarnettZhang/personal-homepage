---
import { profile } from "../data/profile";
import { t } from "../i18n/ui";

const lang = Astro.locals.lang;
const navItems = [
  { href: "/", label: t(lang, "nav.home") },
  { href: "/about", label: t(lang, "nav.work") },
  { href: "/hobbies", label: t(lang, "nav.hobbies") },
  { href: "/travel", label: t(lang, "nav.travel") },
];
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/80 backdrop-blur-md border-b border-border/50">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-3">
    <a href="/" class="text-xl font-serif font-bold tracking-wide text-ink hover:text-sage transition-colors">
      {profile.name}
    </a>

    <div class="flex items-center gap-2 md:gap-3">
      <!-- Desktop -->
      <ul class="hidden md:flex items-center gap-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                class={`relative px-4 py-2 text-sm font-medium rounded-full transition-all duration-200 ${
                  isActive
                    ? "text-sage bg-sage-subtle"
                    : "text-ink-muted hover:text-ink hover:bg-cream-warm"
                }`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- 语言切换 -->
      <div
        class="flex items-center rounded-full border border-border overflow-hidden shrink-0"
        role="group"
        aria-label="Language"
      >
        <button
          data-lang="zh"
          class={`px-2.5 py-1 text-xs font-medium transition-colors cursor-pointer ${
            lang === "zh" ? "bg-sage-subtle text-sage" : "text-ink-muted hover:text-ink"
          }`}
        >
          中
        </button>
        <button
          data-lang="en"
          class={`px-2.5 py-1 text-xs font-medium transition-colors cursor-pointer ${
            lang === "en" ? "bg-sage-subtle text-sage" : "text-ink-muted hover:text-ink"
          }`}
        >
          EN
        </button>
      </div>

      <!-- Mobile -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-ink-muted hover:text-ink transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-cream/95 backdrop-blur-md">
    <ul class="px-6 py-4 space-y-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <li>
            <a
              href={item.href}
              class={`block px-4 py-3 rounded-xl text-sm font-medium transition-all ${
                isActive
                  ? "text-sage bg-sage-subtle"
                  : "text-ink-muted hover:text-ink hover:bg-cream-warm"
              }`}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => menu.classList.toggle("hidden"));
  }

  document.querySelectorAll("[data-lang]").forEach((el) => {
    el.addEventListener("click", () => {
      document.cookie = `lang=${el.getAttribute("data-lang")}; path=/; max-age=31536000; samesite=lax`;
      location.reload();
    });
  });
</script>
